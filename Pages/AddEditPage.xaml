<Page x:Class="trpo7.Pages.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trpo7.Pages"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" Margin="20" Background="#FF3DF7B4">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Content="Создание (изменение) книги" HorizontalAlignment="Center" FontSize="20"/>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox Text="{Binding Book.Title, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Введите название"/>
                <TextBox Text="{Binding Book.Author, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Введите автора"/>
                <md:NumericUpDown Value="{Binding Book.PublishYear, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Введите год издания" />
                <md:NumericUpDown Value="{Binding Book.Price, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Введите цену" />
                <ToggleButton IsChecked="{Binding Book.IsAvailable, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Наличие"/>
                <Button Content="Сохранить" Click="Save_Click"/>
                <Button Content="Назад" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
