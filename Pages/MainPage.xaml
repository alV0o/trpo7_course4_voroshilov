<Page x:Class="trpo7.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trpo7.Pages"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <ListView ItemsSource="{Binding Books}"
                  Grid.Column="1"
                  VerticalAlignment="Stretch" 
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  SelectedItem="{Binding SelectedBook}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Label Content="{Binding Id}"/>
                        <Label Content="{Binding Title}"/>
                        <Label Content="{Binding Author}"/>
                        <TextBlock Text="{Binding Price}"/>
                        <TextBlock Text="{Binding PublishYear}"/>
                        <TextBlock Text="{Binding IsAvailable}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Button Content="Получить записи" FontSize="12" Click="GetAll_Click"/>
                <TextBox Text="{Binding Author}" md:HintAssist.Hint="Введите автора" />
                <TextBlock Text="Введите мин. год издания"/>
                <md:NumericUpDown Value="{Binding MinYear}" md:HintAssist.Hint="Введите мин. год издания" />
            </StackPanel>
            
            <StackPanel Grid.Row="1">
                <TextBlock Text="Введите номер книги"/>
                <md:NumericUpDown Value="{Binding Index}" md:HintAssist.Hint="Введите номер книги"/>
                <Button Content="Найти книгу" FontSize="12" Click="GetById_Click"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2">
                <Button Content="Добавить книгу" Click="Add_Click"/>
                <Button Content="Изменить книгу" Click="Edit_Click"/>
                <Button Content="Удалить книгу" Click="Delete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
